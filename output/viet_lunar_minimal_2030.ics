BEGIN:VCALENDAR
VERSION:2.0
PRODID:-//VietLunarCalendar//Vietnamese Lunar Calendar//VI
CALSCALE:GREGORIAN
METHOD:PUBLISH
X-WR-CALDESC:Chỉ gồm Rằm (ngày 15 âm lịch, kể cả tháng nhu
 ận) và Mùng 1 Tết Nguyên Đán (tháng Giêng không nhuận). Khô
 ng phải thời điểm trăng tròn thiên văn chính xác. Múi giờ 
 GMT+7 - Asia/Ho_Chi_Minh.
X-WR-CALNAME:Lịch Âm Việt Nam - Tối Giản 2030
X-APPLE-CALENDAR-COLOR:#E53935
X-WR-TIMEZONE:Asia/Ho_Chi_Minh
BEGIN:VEVENT
SUMMARY:Rằm
DTSTART;VALUE=DATE:20300118
DTEND;VALUE=DATE:20300119
DTSTAMP:20260928T071132Z
UID:vnlunar-minimal-20300118@cmduyeen
COLOR:#FB8C00
DESCRIPTION:Ngày 15 tháng 12 âm lịch (Kỷ Dậu)\nNgày 15 âm lịch
  theo truyền thống\, không phải thời điểm trăng tròn thiên 
 văn chính xác.
END:VEVENT
