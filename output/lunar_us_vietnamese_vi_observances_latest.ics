DTSTART;VALUE=DATE:20270207
DTEND;VALUE=DATE:20270208
DTSTAMP:20261114T154343Z
UID:lunar-us-vn-observances-tet_day_2-vn-2027@cmduyeen
SEQUENCE:1
COLOR:crimson
DESCRIPTION:Việt Nam: Mùng 2 Tết\nNgày âm: 2/1/2027\n\nNgày lễ t
 ruyền thống\; không phải lịch nghỉ chính thức hoặc nghỉ 
 bù.\nDành cho cộng đồng tại Hoa Kỳ. Ngày lễ theo hệ lịch
  gốc\, không phải ngày nghỉ chính thức của Mỹ. Sự kiện 
 cả ngày không được dịch sang ngày khác theo múi giờ.
LAST-MODIFIED:20261114T154343Z
TRANSP:TRANSPARENT
X-COUNTRIES:VN
X-EVENT-CATEGORY:lunar
X-LUNAR-COLOR:#E53935
X-LUNAR-EVENT-ID:tet_day_2
X-RESIDENCE:US
END:VEVENT
